{
  "name": "@idealyst/dnd",
  "version": "1.3.22",
  "description": "Cross-platform drag-and-drop hooks for React and React Native",
  "readme": "README.md",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.native.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/IdealystIO/idealyst-framework.git",
    "directory": "packages/dnd"
  },
  "author": "Idealyst <contact@idealyst.io>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./examples": {
      "import": "./src/examples/index.ts",
      "require": "./src/examples/index.ts",
      "types": "./src/examples/index.ts"
    }
  },
  "scripts": {
    "prepublishOnly": "echo 'Publishing TypeScript source directly'",
    "publish:npm": "npm publish"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "react-native": "^0.80.1",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-reanimated": "^4.1.3",
    "typescript": "^5.0.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "react",
    "react-native",
    "drag-and-drop",
    "dnd",
    "sortable",
    "draggable",
    "droppable",
    "hooks",
    "cross-platform",
    "reanimated",
    "gesture-handler",
    "idealyst"
  ]
}
